Socket = TcpSocket.New();

-- Status display
function updateStatus(val, str)
  Controls['Status'].Value = val;
  Controls['Status'].String = str;
end; updateStatus(5, 'connecting...');

-- Socket data handler
Socket.EventHandler = function(sock, evt, data)
  if(evt == TcpSocket.Events.Connected) then
    updateStatus(0, 'connected');
  elseif(evt == TcpSocket.Events.Data) then
    local reply = Socket:ReadLine(TcpSocket.EOL.Any);
    while(reply ~= nil) do
      handleFeedback(reply)
      reply = Socket:ReadLine(TcpSocket.EOL.Any);
    end;
    processStatus();
  elseif evt == TcpSocket.Events.Reconnect then
    updateStatus(5, 'Connecting');
  elseif evt == TcpSocket.Events.Closed then
    updateStatus(2, 'Closed by remote');
  elseif evt == TcpSocket.Events.Error then
    updateStatus(2, 'Socket error');
  elseif evt == TcpSocket.Events.Timeout then
    updateStatus(2, 'Timeout');
  end;
end;

-- Poll timer
PollTimer = Timer.New();
PollTimer.EventHandler = function()
  PollTimer:Stop();
  if(Socket.IsConnected) then
    Socket:Write('getStatus\r\n');
  end;
end;
PollTimer:Start(0.1);

-- Feedback handler
STATUS = {};
function handleFeedback(line)
  local prop,val = line:match('(.*):(.*)');
  STATUS[prop] = val;
end;

-- Button status, string, colour
function updateButton(ctrl, str, col, bool);
  ctrl.Legend = str;
  ctrl.Color = col;
  ctrl.Boolean = bool;
end;

-- Status updater
require('json');
function processStatus()
  print(json.encode(STATUS));
  Controls['Stream Number'].String = STATUS['STREAM'] and STATUS['STREAM'] or '';
  
  if(STATUS['DVIINPUT']) then
    if(STATUS['DVIINPUT'] == 'connected') then
      updateButton(Controls['HDMI Present'], 'CONNECTED', 'green', 'true');
    else
      updateButton(Controls['HDMI Present'], 'DISCONNECTED', 'red', 'false');
    end;
  else
    updateButton(Controls['HDMI Present'], 'UNKNOWN', 'gray', 'false');
  end;
  
  if(STATUS['DVIINPUT']) then
    if(STATUS['DVIINPUT'] == 'connected') then
      updateButton(Controls['HDMI Present'], 'CONNECTED', 'green', 'true');
    else
      updateButton(Controls['HDMI Present'], 'DISCONNECTED', 'red', 'false');
    end;
  else
    updateButton(Controls['HDMI Present'], 'UNKNOWN', 'gray', 'false');
  end;
  
end;

-- Connection Manager
function reconnect()
  if(Socket.IsConnected) then Socket:Disconnect(); end;
  if(not Controls['IP'].String:match('%d+%.%d+%.%d+%.%d+')) then
    Controls['IP'].Color = 'red';
    updateStatus(2, 'Invalid IP address');
    return;
  else
    Controls['IP'].Color = 'white';
  end;
  Socket:Connect(Controls['IP'].String, 50002);
end; reconnect();
Controls['IP'].EventHandler = reconnect;
