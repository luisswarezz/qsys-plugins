--========================================================
-- SVSi Encoder / Decoder TCP Script (Q-SYS Script Controller)
-- Fixes:
--  - Checks TcpSocket exists (prevents nil crash message)
--  - Uses booleans true/false (not strings)
--  - Removes duplicated HDMI block
--  - Adds a simple repoll timer loop
--  - More robust line parsing
--
-- REQUIRED CONTROLS (create in the Script Controller):
--   Text:    IP
--   Indicator/Text: Status   (or Text + Indicator; uses .Value and .String)
--   Text:    Stream Number
--   Button/Indicator: HDMI Present  (uses Legend, Color, Boolean)
--========================================================

-- Make sure we are in a scripting context that supports sockets
if TcpSocket == nil then
  print("ERROR: TcpSocket API not available in this component/context. Use a Script Controller.")
  if Controls["Status"] then
    Controls["Status"].Value = 2
    Controls["Status"].String = "TcpSocket not available"
  end
  return
end

Socket = TcpSocket.New()

-- Status display
function updateStatus(val, str)
  if Controls["Status"] then
    Controls["Status"].Value = val
    Controls["Status"].String = str
  end
end

updateStatus(5, "connecting...")

-- Feedback storage
STATUS = {}

-- Feedback handler
function handleFeedback(line)
  -- Expect "KEY:VALUE"
  local prop, val = line:match("^%s*(.-)%s*:%s*(.-)%s*$")
  if prop and val and prop ~= "" then
    STATUS[prop] = val
  end
end

-- Button status, string, colour
function updateButton(ctrl, str, col, bool)
  if not ctrl then return end
  ctrl.Legend = str
  ctrl.Color = col
  ctrl.Boolean = bool
end

-- JSON is optional; don't hard-fail if not present
local hasJson, json = pcall(require, "json")

function processStatus()
  if hasJson and json then
    print(json.encode(STATUS))
  else
    -- Minimal debug if json lib isn't present
    -- print("STATUS updated")
  end

  if Controls["Stream Number"] then
    Controls["Stream Number"].String = STATUS["STREAM"] or ""
  end

  -- HDMI (SVSi often reports DVIINPUT connected/disconnected)
  local dvi = STATUS["DVIINPUT"]
  if dvi == "connected" then
    updateButton(Controls["HDMI Present"], "CONNECTED", "green", true)
  elseif dvi == "disconnected" then
    updateButton(Controls["HDMI Present"], "DISCONNECTED", "red", false)
  else
    updateButton(Controls["HDMI Present"], "UNKNOWN", "gray", false)
  end
end

-- Read all available lines
local function readAllLines()
  while true do
    local reply = Socket:ReadLine(TcpSocket.EOL.Any)
    if reply == nil then break end
    if reply ~= "" then
      handleFeedback(reply)
    end
  end
  processStatus()
end

-- Socket event handler
Socket.EventHandler = function(sock, evt, data)
  if evt == TcpSocket.Events.Connected then
    updateStatus(0, "connected")
    -- Immediate poll on connect
    Socket:Write("getStatus\r\n")

  elseif evt == TcpSocket.Events.Data then
    readAllLines()

  elseif evt == TcpSocket.Events.Reconnect then
    updateStatus(5, "connecting")

  elseif evt == TcpSocket.Events.Closed then
    updateStatus(2, "closed by remote")

  elseif evt == TcpSocket.Events.Error then
    updateStatus(2, "socket error")

  elseif evt == TcpSocket.Events.Timeout then
    updateStatus(2, "timeout")
  end
end

-- Poll timer (continuous)
PollTimer = Timer.New()
PollTimer.EventHandler = function()
  PollTimer:Stop()
  if Socket.IsConnected then
    Socket:Write("getStatus\r\n")
  end
  PollTimer:Start(2) -- poll every 2 seconds
end
PollTimer:Start(0.5)

-- Connection Manager
function reconnect()
  -- Validate IP
  local ipCtrl = Controls["IP"]
  local ip = ipCtrl and ipCtrl.String or ""

  if not ip:match("^%d+%.%d+%.%d+%.%d+$") then
    if ipCtrl then ipCtrl.Color = "red" end
    updateStatus(2, "invalid IP address")
    return
  else
    if ipCtrl then ipCtrl.Color = "white" end
  end

  -- Reconnect
  if Socket.IsConnected then
    Socket:Disconnect()
  end

  updateStatus(5, "connecting...")
  Socket:Connect(ip, 50002)
end

-- Start connection
reconnect()

-- Reconnect whenever IP changes
if Controls["IP"] then
  Controls["IP"].EventHandler = reconnect
end
