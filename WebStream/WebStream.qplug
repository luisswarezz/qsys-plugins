--[[
  SVSi Encoder 1122a Q-Sys Plugin
  Based on Decoder v1.4 structure
  Compatible with Gen2 firmware on port 50002
]]

PluginInfo = {
  Name = "SVSi Encoder 1122a",
  Version = "1.0",
  Id = "a7f61c29-enc1122a-0001",
  Description = "SVSi Encoder Control",
  ShowDebug = false
}

function GetColor()
  return {0,0,0}
end

function GetProperties()
  return {}
end

function GetControls(props)

  return {

    { Name="Stream", ControlType="Text", UserPin=true, PinStyle="Both" },

    { Name="Video Mute", ControlType="Button", ButtonType="Toggle", UserPin=true, PinStyle="Both" },
    { Name="Audio Mute", ControlType="Button", ButtonType="Toggle", UserPin=true, PinStyle="Both" },

    { Name="Input Resolution", ControlType="Indicator", IndicatorType="Text", UserPin=true, PinStyle="Output" },
    { Name="Bitrate", ControlType="Indicator", IndicatorType="Text", UserPin=true, PinStyle="Output" },

    { Name="Input Connected", ControlType="Indicator", IndicatorType="Led", UserPin=true, PinStyle="Output" },

    { Name="Unit Type", ControlType="Indicator", IndicatorType="Text", UserPin=true, PinStyle="Output" },
    { Name="Serial", ControlType="Indicator", IndicatorType="Text", UserPin=true, PinStyle="Output" },
    { Name="Name", ControlType="Indicator", IndicatorType="Text", UserPin=true, PinStyle="Output" },
    { Name="SW Version", ControlType="Indicator", IndicatorType="Text", UserPin=true, PinStyle="Output" },

    { Name="IP", ControlType="Text", UserPin=true, PinStyle="Both" },
    { Name="Status", ControlType="Indicator", IndicatorType="Status", UserPin=true, PinStyle="Output" }

  }
end

function GetControlLayout(props)
  return {}
end

if(not Controls) then return end

SVSiSocket = TcpSocket.New()
ENC_STATUS = {}

SVSiSocket.ReadTimeout = 2
SVSiSocket.WriteTimeout = 0
SVSiSocket.ReconnectTimeout = 3

function updateStatus(code, str)
  Controls["Status"].Value = code
  Controls["Status"].String = str
end

SVSiSocket.EventHandler = function(sock, evt)

  if evt == TcpSocket.Events.Data then

    local line = sock:ReadLine(TcpSocket.EOL.Any)
    while line ~= nil do
      handleFeedback(line)
      line = sock:ReadLine(TcpSocket.EOL.Any)
    end

    updateStatus(0,'')
    updateDisplay()
    doDiff()

  elseif evt == TcpSocket.Events.Reconnect then
    updateStatus(5,"Connecting")

  elseif evt == TcpSocket.Events.Closed then
    updateStatus(2,"Closed")

  elseif evt == TcpSocket.Events.Error then
    updateStatus(2,"Socket Error")

  elseif evt == TcpSocket.Events.Timeout then
    updateStatus(2,"Timeout")
  end
end

PollTimer = Timer.New()
PollTimer.EventHandler = function()
  if SVSiSocket.IsConnected then
    SVSiSocket:Write("?;\r\n")
  end
end
PollTimer:Start(0.5)

function handleFeedback(line)
  local prop,val = line:match("(.*):(.*)")
  if prop and val then
    ENC_STATUS[prop] = val
  end
end

function updateDisplay()

  Controls["Input Resolution"].String =
      ENC_STATUS["INPUTRES"] or ENC_STATUS["MODE"] or ""

  Controls["Bitrate"].String =
      ENC_STATUS["BITRATE"] or ""

  local inputConnected = ENC_STATUS["HDMISTATUS"] ~= "disconnected"
  Controls["Input Connected"].Boolean = inputConnected

  Controls["Video Mute"].Boolean =
      ENC_STATUS["VIDEOMUTE"] == "on"

  Controls["Audio Mute"].Boolean =
      ENC_STATUS["MUTE"] ~= "0"

  Controls["Stream"].String =
      ENC_STATUS["STREAM"] or ""

  local model = ENC_STATUS["SVSI_TXGEN2"]
                or ENC_STATUS["MODEL"]
                or ""

  Controls["Unit Type"].String = model
  Controls["Serial"].String = ENC_STATUS["SERIAL"] or model or ""
  Controls["Name"].String = ENC_STATUS["NAME"] or ""
  Controls["SW Version"].String = ENC_STATUS["SWVER"] or ""
end

function doDiff()

  -- Stream change
  local desiredStream = Controls["Stream"].String
  if desiredStream ~= "" and tonumber(desiredStream) ~= nil then
    if ENC_STATUS["STREAM"] ~= desiredStream then
      SVSiSocket:Write("set:"..desiredStream..";\r\n")
      return
    end
  end

  -- Video mute
  local desiredVideoMute = Controls["Video Mute"].Boolean
  if desiredVideoMute ~= (ENC_STATUS["VIDEOMUTE"] == "on") then
    if desiredVideoMute then
      SVSiSocket:Write("videomute:on;\r\n")
    else
      SVSiSocket:Write("videomute:off;\r\n")
    end
    return
  end

  -- Audio mute
  local desiredAudioMute = Controls["Audio Mute"].Boolean
  if desiredAudioMute ~= (ENC_STATUS["MUTE"] ~= "0") then
    if desiredAudioMute then
      SVSiSocket:Write("mute;\r\n")
    else
      SVSiSocket:Write("unmute;\r\n")
    end
    return
  end

end

function updateIP()
  if SVSiSocket.IsConnected then
    SVSiSocket:Disconnect()
  end
  SVSiSocket:Connect(Controls["IP"].String, 50002)
  updateStatus(5,"Connecting")
end

Controls["IP"].EventHandler = updateIP
updateIP()
